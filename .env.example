# Legacy Ollama client (src/common/llm.py OllamaClient; nothing in Phase 3 uses it since D59):
OLLAMA_BASE_URL=http://localhost:11434
GENERATOR_MODEL=qwen2.5:7b
JUDGE_MODEL=llama3.1:8b
EMBED_MODEL=bge-m3
# Hosted OpenAI-compatible LLM API, free tier only (D59). ANY key below unset = the scripts refuse to
# run. GENERATOR_MODEL and JUDGE_MODEL above must differ (generator openai/gpt-oss-20b, judge
# openai/gpt-oss-120b); the judge is unused in Phase 3. The limits are the free-plan numbers the OWNER
# reads from the provider's dashboard (per minute / per day); the client keeps a 20% margin.
LLM_API_BASE_URL=https://api.example.test/openai/v1
LLM_API_KEY=your-api-key-here
LLM_RPM=30
LLM_TPM=8000
LLM_RPD=1000
LLM_TPD=200000
# Optional: LLM_JSON_MODE=none turns response_format json_object off (default json_object)
EVAL_REFERENCE_DATE=2026-10-18
# Optional (defaults shown)
# LLM_SEED=42
# LLM_RETRY_BUDGET_S=300
# CACHE_DIR=.cache
# Phase 2 chunking: local folder with the bge-m3 tokenizer.json (never downloaded). Unset = regex
# token proxy (fine for dry runs; the freeze needs the real tokenizer, D48).
# TOKENIZER_DIR=
# Phase 3 query-time embedding (D51): local folder with the full bge-m3 model for sentence-transformers.
# The owner downloads it; nothing downloads it for you.
# EMBED_LOCAL_DIR=models/bge-m3-full
# Data collection (Phase 1). CONTACT_EMAIL goes into the User-Agent of every request: required.
CONTACT_EMAIL= you@example.com
# Optional credentials: a source without its credentials is skipped and reported, never faked.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# YOUTUBE_API_KEY=
# SEARCH_API_KEY=
